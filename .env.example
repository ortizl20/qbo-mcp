# Bring your own Intuit app. Leave placeholders to use the recorded Acme fixture.
# Never commit a filled copy of this file.
# Official OAuth 2.0: developer.intuit.com .../authentication-and-authorization/oauth-2.0
# Accounting scope used when building a live authorize URL: com.intuit.quickbooks.accounting
# Payroll Compensation (payroll.compensation.read) is partner-gated and not in sandbox.

INTUIT_CLIENT_ID=replace_with_your_intuit_client_id
INTUIT_CLIENT_SECRET=replace_with_your_intuit_client_secret
INTUIT_REDIRECT_URI=http://localhost:8000/callback
INTUIT_ENV=sandbox
QBO_DRY_RUN=1
